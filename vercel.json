{
  "buildCommand": "mkdir -p dist && cp -r src/job_hunter/web_assets/. dist/",
  "outputDirectory": "dist",
  "devCommand": "npx serve src/job_hunter/web_assets -p 8787",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}